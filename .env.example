# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: only these Telegram user IDs can use the bot (comma separated).
# Leave empty to let anyone use it. Get your ID from @userinfobot
ALLOWED_USERS=

# Optional: these user IDs skip the daily limit
ADMIN_USERS=

# Videos per user per day (0 = unlimited). Protects your free Groq quota.
DAILY_LIMIT=10

# Clip tuning
MAX_VIDEO_MINUTES=90
DEFAULT_CLIPS=3
MAX_CLIPS=6
CLIP_MIN_SEC=20
CLIP_MAX_SEC=75
SOURCE_HEIGHT=720

# Models (Groq free tier). The fallback is used if the main one is rate-limited.
WHISPER_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional: path to a Netscape-format cookies.txt exported from a logged-in
# browser. Helps when YouTube blocks downloads from server IPs.
YT_COOKIES_FILE=

# yt-dlp uses a JavaScript runtime for YouTube (Deno by default).
# If you have Node.js instead of Deno, set this to: node
YT_JS_RUNTIME=
