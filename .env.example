# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: only these Telegram user IDs can use the bot (comma separated).
# Leave empty to let anyone use it. Get your ID from @userinfobot
ALLOWED_USERS=

# Optional: these user IDs skip the daily limit
ADMIN_USERS=

# Videos per user per day (0 = unlimited). Protects your free Groq quota.
DAILY_LIMIT=10

# Persistent data directory. Mount a persistent disk here on your hosting provider.
DATA_DIR=data

# Clip tuning
MAX_VIDEO_MINUTES=240
DEFAULT_CLIPS=3
MAX_CLIPS=6
CLIP_MIN_SEC=20
CLIP_MAX_SEC=60
SOURCE_HEIGHT=720

# Groq models. The fallback is used if the main one is rate-limited.
WHISPER_MODEL=whisper-large-v3
# Optional: set WHISPER_LANGUAGE=en for English-only sources; leave blank for auto-detection.
WHISPER_LANGUAGE=
# Optional: names, brands, acronyms or topic vocabulary in the audio language (max 224 tokens).
WHISPER_PROMPT=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# Optional: YouTube login cookies. Helps when YouTube blocks downloads from
# server IPs. Use a throwaway Google account, never your main one. Pick ONE:
#   YT_COOKIES       paste the cookies as text (Netscape cookies.txt, or the
#                    JSON export from the Cookie-Editor browser extension)
#   YT_COOKIES_B64   the same thing, base64-encoded
#   YT_COOKIES_FILE  path to a cookies.txt file (when running on your own machine)
YT_COOKIES=
YT_COOKIES_B64=
YT_COOKIES_FILE=

# yt-dlp uses a JavaScript runtime for YouTube (Deno by default).
# If you have Node.js instead of Deno, set this to: node
YT_JS_RUNTIME=

# Optional translated voiceover is configured per Telegram user with /voiceover Spanish.
# It uses Edge TTS; no API key is required, but outbound internet is required.

# Optional Premium payments (Paystack). Choose your own price in kobo.
PAYSTACK_SECRET_KEY=
PAYSTACK_PREMIUM_PRICE_KOBO=
PAYSTACK_CALLBACK_URL=

# Optional: free stock footage for B-roll cutaways (https://www.pexels.com/api/).
# Without it B-roll is skipped, or taken from BROLL_DIR if you point it at a folder
# of .mp4 files named after what they show (e.g. city_skyline.mp4).
PEXELS_API_KEY=
BROLL_DIR=
