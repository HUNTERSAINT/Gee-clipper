# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: only these Telegram user IDs can use the bot (comma separated).
# Leave empty to let anyone use it. Get your ID from @userinfobot
ALLOWED_USERS=

# Optional: these user IDs skip the daily limit
ADMIN_USERS=

# Videos per user per day (0 = unlimited). Protects your free Groq quota.
DAILY_LIMIT=10

# Clip tuning
MAX_VIDEO_MINUTES=90
DEFAULT_CLIPS=3
MAX_CLIPS=6
CLIP_MIN_SEC=20
CLIP_MAX_SEC=75
SOURCE_HEIGHT=720

# Models (Groq free tier). The fallback is used if the main one is rate-limited.
WHISPER_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional: YouTube login cookies. Helps when YouTube blocks downloads from
# server IPs. Use a throwaway Google account, never your main one. Pick ONE:
#   YT_COOKIES       paste the cookies as text (Netscape cookies.txt, or the
#                    JSON export from the Cookie-Editor browser extension)
#   YT_COOKIES_B64   the same thing, base64-encoded
#   YT_COOKIES_FILE  path to a cookies.txt file (when running on your own machine)
YT_COOKIES=
YT_COOKIES_B64=
YT_COOKIES_FILE=

# yt-dlp uses a JavaScript runtime for YouTube (Deno by default).
# If you have Node.js instead of Deno, set this to: node
YT_JS_RUNTIME=
